    "svelte": "^5.56.10",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "lucide-svelte": "^1.0.1",
    "svelte-spa-router": "^5.1.1"
  }
